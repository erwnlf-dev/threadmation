# Salin file ini ke .env lalu isi. JANGAN commit .env ke git.

# Long-lived access token Threads (dari Meta App > Threads > User Token Generator).
# Boleh kosong untuk mode X saja (crawl leads X + cross-post tanpa Threads).
THREADS_ACCESS_TOKEN=

# Opsional: ID user Threads. Kalau kosong, diambil otomatis dari /me.
THREADS_USER_ID=

# App secret dari Meta App (dipakai untuk verifikasi signature webhook).
THREADS_APP_SECRET=

# Token bebas buatan Anda sendiri, diisi juga di Meta App saat setup webhook.
THREADS_WEBHOOK_VERIFY_TOKEN=

# API key untuk endpoint HTTP (dipakai pipeline lain saat memanggil bot ini).
THREADMATION_API_KEY=

# Lokasi database SQLite & file rules.
THREADMATION_DB=threadmation.db
THREADMATION_RULES=config/rules.yaml

# Opsional: URL yang menerima POST JSON setiap ada event (lead.created, dm.queued, post.published)
# (mis. n8n, Make, Zapier, CRM, atau service internal Anda).
THREADMATION_EVENT_WEBHOOK_URL=

# Opsional: ganti ke https://graph.threads.com/v1.0 bila perlu.
THREADS_API_BASE=https://graph.threads.net/v1.0

# true = balasan otomatis langsung dikirim saat webhook mention/reply masuk.
# Default false: webhook hanya menyimpan lead, balasan dikirim lewat `threadmation respond --live`.
THREADMATION_WEBHOOK_AUTO_REPLY=false

# ---------------------------------------------------------------------------
# Cross-post via @opencoredev/social-sdk (folder social-bridge/, butuh Node >= 22.12)
# Platform aktif otomatis kalau kredensialnya diisi. Cek: threadmation social platforms
# ---------------------------------------------------------------------------
# Default target cross-post untuk setiap post baru (kosong = tidak cross-post). Contoh: x,bluesky
THREADMATION_CROSSPOST=
# Opsional: lokasi folder bridge (default: social-bridge/ di repo ini).
THREADMATION_SOCIAL_BRIDGE=

# X: user ID numerik + OAuth 2.0 user access token (scope tweet.read, tweet.write, users.read) untuk posting.
SOCIAL_X_USER_ID=
SOCIAL_X_ACCESS_TOKEN=
# X: app-only Bearer Token (developer.x.com > Keys and tokens). Cukup ini untuk crawl leads di X.
# Search hanya mencakup 7 hari terakhir dan butuh paket X API berbayar.
SOCIAL_X_BEARER_TOKEN=

# Bluesky: handle + App Password (Settings > Privacy and security > App passwords).
SOCIAL_BLUESKY_HANDLE=
SOCIAL_BLUESKY_APP_PASSWORD=
SOCIAL_BLUESKY_SERVICE=https://bsky.social

# LinkedIn: access token (w_member_social) + author URN (urn:li:person:xxx / urn:li:organization:xxx).
SOCIAL_LINKEDIN_ACCESS_TOKEN=
SOCIAL_LINKEDIN_AUTHOR=
SOCIAL_LINKEDIN_API_VERSION=202609

# 1 = aktifkan platform "mock" (backend tiruan SDK, tanpa network) untuk uji coba.
SOCIAL_SDK_MOCK=
